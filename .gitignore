# --- Server (private) ----------------------------------------------------
# The signaling server is deployed to a VPS we control and is intentionally
# not pushed to public git. Anyone cloning this repo gets the client and
# the shared protocol package; that's enough to run the app against any
# compatible signaling endpoint.
server/

# --- Local dev workspace -------------------------------------------------
# go.work is convenient locally (lets us hack on shared/, server/, client/
# with one editor session) but the server reference would break for anyone
# who clones without server/. Each module's go.mod has the full dependency
# information needed to build it stand-alone.
go.work
go.work.sum

# --- Secrets -------------------------------------------------------------
*.pem
*.key
*.crt
.env
.env.local
.env.*.local

# --- Go build artifacts --------------------------------------------------
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
bin/
dist/
# build/ used to be a blanket ignore, which also masked client/build/
# (Wails' build dir) and made it impossible to re-include the
# appicon assets that live there. Anchor the generic ignore to the
# repo root and let per-project patterns below handle nested build
# trees explicitly. Git can't re-include a file whose parent dir is
# ignored, so anchoring at root is the only correct fix here.
/build/
coverage.out
coverage.html

# --- Node / Wails frontend (Phase 2+) ------------------------------------
node_modules/
client/frontend/dist/*
!client/frontend/dist/.gitkeep
client/frontend/package.json.md5
client/frontend/tsconfig.tsbuildinfo
client/frontend/vite.config.d.ts
client/frontend/vite.config.js
client/frontend/node_modules/
# client/build/ holds Wails build outputs (binaries + .app shell),
# but ALSO our source-controlled icon assets. List the artefact
# subdirs explicitly so the appicon.png / appicon.svg at the root
# of the dir stay tracked — git can't re-include files inside an
# ignored directory, only inside an ignored pattern at the file
# level, so this is the correct shape.
client/build/bin/
client/build/darwin/
client/.wails/
# wailsjs/go is regenerated from app.go on every `wails build` — runtime/ is static
client/frontend/wailsjs/go/

# Claude Code per-developer config (plugins, etc.) — like .vscode/, not project-wide.
.claude/

# --- Android / Gradle (mobile/) ------------------------------------------
# Keep the source tree of the mobile project in git, but never the
# build/cache/IDE state that regenerates on every build.
mobile/.gradle/
mobile/.idea/
mobile/build/
mobile/app/build/
mobile/app/release/
mobile/captures/
mobile/local.properties
mobile/.cxx/
mobile/.kotlin/
mobile/.fleet/
**/*.iml
*.hprof
mobile/app/release.keystore
mobile/app/debug.keystore
*.jks

# --- Editors / OS --------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.swn
.fleet/
.zed/
.cursor/

# --- Logs / coverage / profiling ----------------------------------------
*.log
*.prof
*.cover
